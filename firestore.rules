rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && !exists(/databases/$(database)/documents/accountLocks/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasAccess() { return signedIn() && me().active == true && me().get('disabled', false) == false && me().get('deletionPending', false) == false; }
    function isStaff() { return hasAccess() && me().role != 'Student'; }
    function isAdmin() { return isStaff() && me().role == 'Admin'; }
    function isShDepartment(value) {
      return value.matches('(?i)^s&h$')
        || value.matches('(?i)^science and humanities$')
        || value.matches('(?i)^science and humanities \\(s&h\\)$');
    }
    function isEngineeringName(value) { return value.matches('(?i).*engineering.*'); }
    function validContacts(data) {
      return data.get('studentPhone', '').matches('^[6-9][0-9]{9}$')
        && data.get('parentPhone', '').matches('^[6-9][0-9]{9}$')
        && data.studentPhone != data.parentPhone;
    }
    function validProfile(data) {
      let role = data.get('requestedRole', data.role);
      let common = role in ['Class Advisor','HOD'] && isShDepartment(data.get('department', ''));
      return role in ['Student','Class Advisor','HOD','Principal','Year Warden','Resident Councillor','Security','Admin']
        && data.displayName is string && data.displayName.size() > 0
        && data.get('registerNumber', '').matches('^[A-Z0-9_-]+$') && data.get('registerNumber', '').size() <= 40
        && (!(role in ['Student','Class Advisor','HOD','Principal']) || data.get('institution', '').size() > 0)
        && (!(role in ['Student','Class Advisor','HOD']) || data.get('department', '').size() > 0)
        && (!(role in ['Student','Class Advisor']) || (common || data.get('year', 0) in [1,2,3,4,5,6,7,8]))
        && (!(role in ['Student','Class Advisor']) || common || data.get('section', '').size() > 0)
        && (!(role in ['Year Warden','Resident Councillor']) || data.get('hostel', '') in ['Boys hostel','Girls hostel'])
        && (!common || (isEngineeringName(data.get('institution', '')) && data.get('year', 0) == 1))
        && (!(role == 'Student' && isShDepartment(data.get('department', ''))) || (isEngineeringName(data.get('institution', '')) && data.get('year', 0) == 1))
        && (role != 'Admin' || data.get('position', '').size() > 0)
        && (role == 'Student' ? validContacts(data) && data.get('gender', '') in ['Male','Female','Other']
          && data.get('studentType', 'HOSTELLER') in ['HOSTELLER','DAY_SCHOLAR'] : data.get('phone', '').matches('^[6-9][0-9]{9}$'))
        && data.get('sections', []) is list && data.get('sections', []).size() <= 50;
    }
    function requestGender() {
      return resource.data.get('gender', '') in ['Male','Female'] ? resource.data.gender
        : resource.data.get('hostel', '') == 'Boys hostel' ? 'Male'
        : resource.data.get('hostel', '') == 'Girls hostel' ? 'Female' : '';
    }
    function commonFirstYear() {
      return me().role in ['Class Advisor','HOD'] && isShDepartment(me().get('department', ''));
    }
    function inScope() {
      return me().role == 'Security'
        || ((!(me().role in ['Class Advisor','HOD','Principal']) || me().get('institution', '') == '' || me().institution == resource.data.get('institution', ''))
        && (commonFirstYear() ? resource.data.year == 1 && isEngineeringName(resource.data.get('institution', '')) : (!(me().role in ['Class Advisor','HOD']) || me().get('department', '') == '' || me().department == resource.data.department))
        && (commonFirstYear() || me().role != 'Class Advisor' || me().get('year', 0) == 0 || me().get('year', null) == null || me().year == resource.data.year)
        && (me().role != 'Class Advisor' || me().get('section', '') == '' || me().section == resource.data.get('section', ''))
        && (!(commonFirstYear() && me().role == 'HOD') || me().get('sections', []).hasAny([resource.data.get('section', '')]))
        && (!(me().role in ['Year Warden','Resident Councillor']) || (me().hostel == 'Boys hostel' && requestGender() == 'Male') || (me().hostel == 'Girls hostel' && requestGender() == 'Female')));
    }
    function ownsQueue() {
      return (me().role == 'Class Advisor' && resource.data.status == 'PENDING_ADVISOR')
        || (me().role == 'HOD' && resource.data.status == 'PENDING_HOD')
        || (me().role == 'Principal' && resource.data.status == 'PENDING_PRINCIPAL')
        || (me().role == 'Year Warden' && resource.data.status == 'PENDING_WARDEN')
        || (me().role == 'Resident Councillor' && resource.data.status == 'PENDING_COUNCILLOR');
    }

    match /users/{userId} {
      allow create: if (signedIn() && userId == request.auth.uid
        && request.resource.data.role == 'Student'
        && request.resource.data.active == false
        && request.resource.data.approvalStatus == 'PENDING'
        && request.resource.data.email == request.auth.token.email
        && validProfile(request.resource.data)
        && getAfter(/databases/$(database)/documents/registerNumbers/$(request.resource.data.registerNumber)).data.uid == userId)
        || (isAdmin() && request.resource.data.active == true
        && request.resource.data.approvalStatus == 'APPROVED'
        && validProfile(request.resource.data)
        && getAfter(/databases/$(database)/documents/registerNumbers/$(request.resource.data.registerNumber)).data.uid == userId);
      allow read: if signedIn() && (userId == request.auth.uid || isStaff());
      allow update: if isAdmin()
        && resource.data.get('disabled', false) == false && resource.data.get('deletionPending', false) == false
        && resource.data.get('accountOperation', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','approvalStatus','role','reviewedAt','deleted','studentType'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentType'])
          || (request.resource.data.get('studentType', '') in ['HOSTELLER','DAY_SCHOLAR']
          && (resource.data.get('requestedRole', resource.data.role) == 'Student' || resource.data.role == 'Student' && resource.data.approvalStatus == 'APPROVED')))
        && (resource.data.role != 'Admin' || (request.resource.data.role == 'Admin'
          && request.resource.data.active == true && request.resource.data.get('deleted', false) == false))
        && (userId != request.auth.uid || request.resource.data.active == true);
      allow update: if isAdmin() && validAdminEdit(userId);
      allow delete: if false;
    }
    function validAdminEdit(userId) {
      let data = request.resource.data;
      return resource.data.get('deletionPending', false) == false && resource.data.get('accountOperation', null) == null
        && data.diff(resource.data).affectedKeys().hasOnly(['displayName','registerNumber','institution','department','year','section','sections','hostel','position','gender','studentType','studentPhone','parentPhone','phone','role','requestedRole','photoUrl','approvalStatus','active','disabled','deleted','reviewedAt','updatedBy'])
        && validProfile(data) && data.role == data.requestedRole
        && data.approvalStatus in ['PENDING','APPROVED','REJECTED','REMOVED']
        && data.disabled is bool && data.active == (data.approvalStatus == 'APPROVED' && data.disabled == false)
        && data.updatedBy == request.auth.uid
        && (userId != request.auth.uid || (data.role == 'Admin' && data.active == true))
        && getAfter(/databases/$(database)/documents/registerNumbers/$(data.registerNumber)).data.uid == userId;
    }

    match /students/{studentId} {
      allow create: if signedIn() && studentId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'Student'
        && request.resource.data.active == false;
      allow create, update: if isAdmin() && request.resource.data.userId == studentId
        && request.resource.data.role == getAfter(/databases/$(database)/documents/users/$(studentId)).data.role
        && request.resource.data.active == getAfter(/databases/$(database)/documents/users/$(studentId)).data.active;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isStaff());
      allow update: if signedIn() && isStaff() && me().role == 'Year Warden';
      allow delete: if false;
    }

    match /registerNumbers/{registerNumber} {
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/registerNumbers/$(registerNumber))
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.registerNumber == registerNumber;
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.registerNumber == registerNumber;
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin() && getAfter(/databases/$(database)/documents/users/$(resource.data.uid)).data.registerNumber != registerNumber;
    }

    match /portalSessions/{userId} {
      allow read: if hasAccess() && userId == request.auth.uid;
      allow create: if hasAccess() && userId == request.auth.uid && validSession();
      allow update: if hasAccess() && userId == request.auth.uid && validSession()
        && (resource.data.expiresAt <= request.time || resource.data.sessionId == request.resource.data.sessionId);
      allow delete: if signedIn() && userId == request.auth.uid;
    }
    function validSession() {
      return request.resource.data.keys().hasOnly(['sessionId','expiresAt'])
        && request.resource.data.sessionId is string && request.resource.data.sessionId.size() >= 20
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(120, 's');
    }

    match /outpasses/{outpassId} {
      allow read: if hasAccess() && (resource.data.studentId == request.auth.uid || isStaff());
      allow create: if hasAccess() && me().role == 'Student'
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'PENDING_ADVISOR'
        && request.resource.data.approvals == []
        && request.resource.data.studentName == me().displayName
        && request.resource.data.registerNumber == me().registerNumber
        && request.resource.data.institution == me().get('institution', '')
        && request.resource.data.department == me().department
        && request.resource.data.year == me().year
        && request.resource.data.get('gender', '') == me().get('gender', '')
        && request.resource.data.get('section', '') == me().get('section', '')
        && request.resource.data.get('archived', false) == false
        && request.resource.data.get('category', 'OUTING') in ['OUTING','EMERGENCY','ON_DUTY','HOLIDAY','LEAVE']
        && request.resource.data.get('studentType', 'HOSTELLER') == me().get('studentType', 'HOSTELLER')
        && request.resource.data.get('permissionPolicy', 'FULL_APPROVAL') == 'FULL_APPROVAL'
        && request.resource.data.get('responsibilityAccepted', false) == true
        && validContacts(request.resource.data)
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 600
        && request.resource.data.outAtTimestamp is timestamp
        && request.resource.data.returnAtTimestamp is timestamp
        && request.resource.data.outAtTimestamp > request.time
        && request.resource.data.returnAtTimestamp > request.resource.data.outAtTimestamp;
      allow update: if isStaff() && inScope() && resource.data.get('archived', false) == false
        && (validOutpassTransition() || (ownsQueue()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived','archivedBy','updatedAt'])
          && request.resource.data.archived == true && request.resource.data.archivedBy == request.auth.uid));
      allow update: if isAdmin() && adminCorrection();
      allow delete: if false;
      match /{document=**} {
        allow read: if hasAccess()
          && (get(/databases/$(database)/documents/outpasses/$(outpassId)).data.studentId == request.auth.uid || isStaff());
        allow write: if false;
      }
    }

    function validOutpassTransition() {
      let old = resource.data.status;
      let next = request.resource.data.status;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['status','approvals','updatedAt','passNumber','hostel'])
        && (!changed.hasAny(['hostel']) || (me().role == 'Principal' && next == 'PENDING_WARDEN'
          && request.resource.data.hostel == (resource.data.get('gender', '') == 'Male' ? 'Boys hostel'
            : resource.data.get('gender', '') == 'Female' ? 'Girls hostel' : 'Hostel assignment required')))
        && me().role != 'Security'
        && validApproval(next)
        && ((me().role == 'Class Advisor' && old == 'PENDING_ADVISOR' && (next == 'PENDING_HOD' || next == 'REJECTED'))
        || (me().role == 'HOD' && old == 'PENDING_HOD' && (next == 'REJECTED'
          || (next == 'PENDING_PRINCIPAL' && resource.data.get('studentType', 'HOSTELLER') != 'DAY_SCHOLAR')
          || (next == 'APPROVED' && resource.data.get('studentType', 'HOSTELLER') == 'DAY_SCHOLAR'
            && request.resource.data.passNumber is string && request.resource.data.passNumber.size() > 0)))
        || (me().role == 'Principal' && old == 'PENDING_PRINCIPAL' && (next == 'PENDING_WARDEN' || next == 'REJECTED'))
        || (me().role == 'Year Warden' && old == 'PENDING_WARDEN' && (next == 'PENDING_COUNCILLOR' || next == 'REJECTED'))
        || (me().role == 'Resident Councillor' && old == 'PENDING_COUNCILLOR' && (next == 'APPROVED' || next == 'REJECTED')));
    }

    function adminCorrection() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return resource.data.status.matches('PENDING_.*')
        && data.status == resource.data.status
        && changed.hasOnly(['category','reason','studentPhone','parentPhone','outAt','returnAt','outAtTimestamp','returnAtTimestamp','updatedAt','updatedBy'])
        && data.category in ['OUTING','EMERGENCY','ON_DUTY','HOLIDAY','LEAVE']
        && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 600
        && validContacts(data)
        && data.outAtTimestamp is timestamp && data.returnAtTimestamp is timestamp
        && data.returnAtTimestamp > data.outAtTimestamp
        && data.updatedBy == request.auth.uid;
    }

    function validApproval(next) {
      let entries = request.resource.data.approvals;
      let count = resource.data.approvals.size();
      let entry = entries[count];
      return entries.size() == count + 1
        && entries.removeAll([entry]) == resource.data.approvals
        && entry.role == me().role && entry.approverId == request.auth.uid
        && entry.name == me().displayName
        && entry.decision == (next == 'REJECTED' ? 'REJECTED' : 'APPROVED')
        && (next != 'REJECTED' || entry.remarks.size() > 0);
    }

    match /settings/academic {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['institutions','years','sections','updatedBy','updatedAt'])
        && request.resource.data.institutions is list && request.resource.data.institutions.size() > 0 && request.resource.data.institutions.size() <= 20
        && request.resource.data.years is list && request.resource.data.years.size() > 0 && request.resource.data.years.hasOnly([1,2,3,4,5,6,7,8])
        && request.resource.data.sections is list && request.resource.data.sections.size() > 0 && request.resource.data.sections.size() <= 50
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /adminAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['actorId','targetId','action','at','before','after'])
        && request.resource.data.actorId == request.auth.uid && request.resource.data.at == request.time
        && request.resource.data.action in ['CREATE_USER','EDIT_USER'];
      allow update, delete: if false;
    }

    match /studentDirectory/{studentId} {
      allow read: if signedIn() && isStaff();
      // Imports are validated and scoped by the importStudentDirectory callable.
      allow create, update: if false;
      allow delete: if false;
    }
  }
}
